# Web dashboard (src/web/.env.local)
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# The "anon"/publishable key. Safe to expose to the browser.
# Note the variable name: the app reads NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<...>


# Optional. Public origin of the deployed site, used to resolve Open Graph
# preview images. Only needed on a non-Vercel host. Set it before the build,
# because NEXT_PUBLIC_* is inlined at build time. Leave unset for local development.
# NEXT_PUBLIC_SITE_URL=https://status.example.com

# Local stack: run `npx supabase start` from the repo root and use the two values
# it prints (API URL and anon key) for NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY above. Pointing a dev server at the hosted project
# is how you end up testing against production.
