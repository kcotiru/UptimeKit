# Web dashboard (src/web/.env.local)
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# The "anon"/publishable key. Safe to expose to the browser.
# Note the variable name: the app reads NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<...>

# Server-only. Bypasses row level security — never expose to the browser,
# and never commit a real value here.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
